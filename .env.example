# speed-detector configuration — copy to .env and adjust.
# Every value has a sensible default, so .env is optional.

# --- Detection ---
DETECTOR_BACKEND=onnx            # onnx | ultralytics
ONNX_MODEL_PATH=models/yolo11n.onnx
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.7

# --- Tracking ---
TRACKER=bytetrack                # bytetrack | botsort

# --- Storage ---
DB_URL=sqlite:///data/speed.db

# --- Streaming ---
STREAM_MAX_FPS=15                # cap pushed to browsers

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Local LLM (optional, Phase 5) ---
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:3b
